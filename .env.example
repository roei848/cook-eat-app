# Copy to .env (gitignored). Values are read by app.config.js at build time.

# Gemini API key for recipe extraction / ideas (services/gemini)
GEMINI_API_KEY=

# Google Sign-In: OAuth client ID of type "Web application" from the Firebase
# console (Authentication → Sign-in method → Google → Web SDK configuration).
# Required to receive an ID token that Firebase Auth accepts.
GOOGLE_WEB_CLIENT_ID=

# Optional, iOS only: OAuth client ID of type "iOS" for the app's bundle ID.
# Enables the Google Sign-In config plugin (URL scheme) on prebuild.
GOOGLE_IOS_CLIENT_ID=
