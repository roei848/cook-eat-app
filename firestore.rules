rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- USERS ---
    match /users/{userId} {

      // Logged-in users can read profiles
      allow read: if request.auth != null;

      // User can create their own profile
      allow create: if request.auth != null
        && request.auth.uid == userId;

      // User can ONLY update avatarUrl and darkMode
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["avatarUrl", "darkMode"]);

      // No deletes
      allow delete: if false;

      // --- GROCERY ITEMS (subcollection) ---
      // Only the owner can read/write their own grocery items
      match /grocery/{itemId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }


    // --- RECIPES ---
    // Everyone can read recipes, only logged-in users can create.
    // Only the author can edit/delete their recipe — except `notes`, which
    // any signed-in user may add to or remove from (addRecipeNote /
    // removeRecipeNote write it with arrayUnion / arrayRemove). A write that
    // touches notes together with any other field is still author-only.
    match /recipes/{recipeId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;

      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(["notes"]));

      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // --- GROCERY LISTS (legacy/unused) ---
    // Not used by the current grocery feature — see users/{userId}/grocery above.
    // Safe to remove if nothing else references this collection.
    match /groceryLists/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // --- CATEGORIES ---
    // Publicly readable. Locked for writes (we’ll treat as admin-managed).
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // --- COOK AI HISTORY ---
    // Each user only sees and writes their own AI history
    match /cookAI/{entryId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
